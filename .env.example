# Keep the existing production RESEND_API_KEY. Never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
# Optional: defaults preserve the recipient/sender from the previous site.
CONTACT_EMAIL_TO=litovchenko.inna1970@gmail.com
CONTACT_EMAIL_FROM=Майстерня на Фонтані <onboarding@resend.dev>
# Use an address on a domain verified in Resend for production sending.
# CONTACT_EMAIL_FROM=Майстерня на Фонтані <website@your-verified-domain.com>
# Optional Google Search Console HTML-tag verification token (not the entire tag).
GOOGLE_SITE_VERIFICATION=

# Telegram becomes primary when both values are configured; email remains fallback.
# Server-only values, NEVER use NEXT_PUBLIC_ for them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
